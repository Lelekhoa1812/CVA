{
  "name": "cv-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node -r tsconfig-paths/register -r sucrase/register/ts tests/career/run-tests.ts",
    "test:search": "node -r tsconfig-paths/register -r sucrase/register/ts tests/search/run-tests.ts",
    "test:ai": "node -r tsconfig-paths/register -r sucrase/register/ts tests/ai/run-tests.ts",
    "verify:career": "npm run lint && npm run test:unit && npm run test:auto-apply",
    "test:auto-apply": "node -r tsconfig-paths/register -r sucrase/register/ts tests/auto-apply/run-tests.ts && node -r tsconfig-paths/register -r sucrase/register/ts tests/auto-apply/run-letter-tests.ts && node -r tsconfig-paths/register -r sucrase/register/ts tests/generate/letter-guard-tests.ts",
    "test:autofill-safari": "node -r tsconfig-paths/register -r sucrase/register/ts scripts/autofill-safari.ts",
    "agent:fill": "node -r tsconfig-paths/register -r sucrase/register/ts scripts/agent-fill.ts",
    "test:autofill-live": "node -r tsconfig-paths/register -r sucrase/register/ts scripts/autofill-live.ts",
    "eval:letters": "npx --yes promptfoo@0.125.1 eval -c evals/promptfooconfig.yaml --no-cache"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "9.0.3",
    "mammoth": "^1.12.0",
    "mongoose": "^8.17.2",
    "next": "15.5.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.60.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
